% ============================================================================
% beamercolorthemecaem.sty
% BRAC University-aligned colour theme for the CAEM defence poster, built on
% top of the Gemini beamerposter framework. Primary palette: BRAC navy blue;
% accents pulled from the thesis architecture diagram (teal-700 for verifier /
% storage gate, orange-500 for RUC, green-600 for memory tier, red-500 for
% retention-guard alerts).
%
% This version restyles the headline, footline, and block templates to match
% the BRAC Pre-Thesis 2 sample poster layout:
%   - Navy header bar with BRAC logo (left), title centred, thesis ID +
%     department line beneath in white.
%   - Navy footer bar with four white-text segments separated by hboxes.
%   - Block titles render as bold navy text with a thin horizontal rule
%     beneath (no coloured background bar).
% ============================================================================

\ProvidesPackage{beamercolorthemecaem}

\RequirePackage{graphicx}

\selectcolormodel{RGB}

% --- BRAC institutional ----------------------------------------------------
% Official BRAC University logo palette per the identity guide:
%   blue   #253494  -> RGB(37, 52, 148)   identity-guide primary
%   silver #999999  -> RGB(153,153,153)   identity-guide secondary
%   black  #000000  -> RGB(0,  0,  0)     identity-guide accent
% The header / footer / block-title navy on the printed defence poster
% uses #003E72 (RGB 0, 62, 114) sampled directly from the BRAC Pre-Thesis
% 2 sample poster image (40 081 of the 43 429 pixels measured in the
% header band rendered at exactly this value). Reads as a deeper, more
% conservative defence-poster navy than the more royal-blue identity-
% guide primary, and matches the printed BRAC defence-poster convention.
\definecolor{bracnavy}{RGB}{0,62,114}      % defence-poster navy #003E72
\definecolor{bracnavydark}{RGB}{0,40,72}   % darker navy for emphasis
\definecolor{bracidentityblue}{RGB}{37,52,148} % official #253494, kept for in-content highlight use
\definecolor{bracsilver}{RGB}{153,153,153} % identity-guide silver secondary
\definecolor{bracred}{RGB}{173,32,46}      % retained for in-content highlights
\definecolor{bracgold}{RGB}{207,154,57}    % retained for accents

% --- Thesis architecture-diagram palette (for figure consistency) ----------
\definecolor{caemTeal}{RGB}{0,128,128}     % verifier, storage gate
\definecolor{caemTealLight}{RGB}{220,242,242}
\definecolor{caemOrange}{RGB}{230,108,0}   % retrieval-utility classifier (Stage 3b)
\definecolor{caemOrangeLight}{RGB}{255,237,213}
\definecolor{caemGreen}{RGB}{40,130,75}    % memory tier
\definecolor{caemGreenLight}{RGB}{226,242,233}
\definecolor{caemRed}{RGB}{198,40,40}      % retention guard, abort markers
\definecolor{caemRedLight}{RGB}{253,230,230}

% --- Neutrals --------------------------------------------------------------
\definecolor{bg}{RGB}{255,255,255}
\definecolor{fg}{RGB}{32,32,32}
\definecolor{lightgrey}{RGB}{238,238,238}
\definecolor{midgrey}{RGB}{170,170,170}

% --- Beamer palette --------------------------------------------------------
\setbeamercolor{background canvas}{bg=bg}
\setbeamercolor{headline}{fg=bg,bg=bracnavy}
\setbeamercolor{footline}{fg=bg,bg=bracnavy}

% The block-title beamer colour is now used only for the title TEXT colour
% (no background bar). Keep fg=bracnavy so \usebeamercolor[fg]{block title}
% inside the overridden template gives the right text colour.
\setbeamercolor{block title}{fg=bracnavy,bg=bg}
\setbeamercolor{block body}{fg=fg,bg=bg}
\setbeamercolor{block alerted title}{fg=bracnavy,bg=bg}
\setbeamercolor{block alerted body}{fg=fg,bg=bg}
\setbeamercolor{block example title}{fg=bracnavy,bg=bg}
\setbeamercolor{block example body}{fg=fg,bg=bg}

% Itemize / enumerate markers
\setbeamercolor{itemize item}{fg=bracnavy}
\setbeamercolor{itemize subitem}{fg=caemTeal}
\setbeamercolor{enumerate item}{fg=bracnavy}

% Heading inside a block (\heading{})
\setbeamercolor{heading}{fg=bracnavy}

% Caption labels
\setbeamercolor{caption name}{fg=bracnavy}

% ============================================================================
% FONT OVERRIDES
% ============================================================================
% The Gemini theme installs Raleway for headings and Lato for sans body, both
% as OpenType fonts. At poster sizes the thin strokes of Raleway-Bold and the
% light cuts of Lato can render as a soft halo / glow in some PDF viewers
% (especially when displayed at non-100% zoom). Latin Modern is already
% loaded via the document-level \usepackage{lmodern} as crisp Type 1
% outlines; redirect every poster-side font slot to Latin Modern so the
% outlines render cleanly across viewers.
% ============================================================================
\renewcommand{\familydefault}{\rmdefault}
\setbeamerfont{headline}{family=\rmfamily}
\setbeamerfont{headline title}{family=\rmfamily,size=\Huge,series=\bfseries}
\setbeamerfont{headline author}{family=\rmfamily,size=\Large}
\setbeamerfont{headline institute}{family=\rmfamily,size=\normalsize}
\setbeamerfont{block title}{family=\rmfamily,size=\large,series=\bfseries}
\setbeamerfont{heading}{family=\rmfamily,series=\bfseries}
\setbeamerfont{caption}{family=\rmfamily,size=\small}
\setbeamerfont{footline}{family=\rmfamily,size=\normalsize}

% ============================================================================
% HEADLINE TEMPLATE
% ============================================================================
% Full-width navy bar (~10cm tall) containing:
%   - BRAC University logo on the left
%   - Bold white title centred in the remaining width
%   - "Md. Aksan Gony Alif | Maliha Binte Shamim | Md. Mahmudur Rahman" line
%     in white below the title
%   - "Department of Computer Science & Engineering, BRAC University" line
%     in white below the authors
% ============================================================================

\setbeamertemplate{headline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=10cm,dp=0pt,leftskip=1.5cm,rightskip=1.5cm]{headline}%
    \vbox to 10cm{%
      \vfill
      \begin{minipage}[c]{8cm}
        % BRAC logo placed directly on the navy header to match the BRAC
        % Pre-Thesis 2 sample style. The standard colour BRAC crest carries
        % blue circular detail that partially blends into the navy
        % background; the silver and lighter elements remain visible.
        % Swap in a white-on-transparent variant of the BRAC logo at this
        % include path to make every detail of the crest fully visible.
        \includegraphics[height=7cm,keepaspectratio]{logos/bracu_logo_12-0-2022.png}%
      \end{minipage}\hfill
      \begin{minipage}[c]{\dimexpr\paperwidth-3cm-9cm\relax}
        \centering
        {\color{white}\bfseries\fontsize{44}{52}\selectfont \inserttitle\par}
        \vspace{0.5cm}
        {\color{white}\fontsize{22}{26}\selectfont Md.\ Aksan Gony Alif \quad|\quad Maliha Binte Shamim \quad|\quad Md.\ Mahmudur Rahman\par}
        \vspace{0.25cm}
        {\color{white}\fontsize{20}{24}\selectfont Department of Computer Science \& Engineering, BRAC University\par}
      \end{minipage}\hfill
      \begin{minipage}[c]{2cm}\hfill\end{minipage}%
      \vfill
    }%
  \end{beamercolorbox}%
}

% ============================================================================
% FOOTLINE TEMPLATE
% ============================================================================
% Full-width navy bar with four white-text segments separated by hboxes:
%   "Pre Thesis 2"  |  "Supervisor : Dr. Md. Golam Rabiul Alam"
%                   |  "Co-Supervisor : Md. Tanzim Reza"
%                   |  "BRAC University"
% ============================================================================

\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.2cm,dp=0pt,leftskip=1.5cm,rightskip=1.5cm]{footline}%
    \vbox to 2.2cm{%
      \vfill
      {\color{white}\bfseries\fontsize{22}{26}\selectfont Pre Thesis 2}%
      \hfill
      {\color{white}\fontsize{22}{26}\selectfont Supervisor : Dr.\ Md.\ Golam Rabiul Alam}%
      \hfill
      {\color{white}\fontsize{22}{26}\selectfont Co-Supervisor : Md.\ Tanzim Reza}%
      \hfill
      {\color{white}\bfseries\fontsize{22}{26}\selectfont BRAC University}%
      \vfill
    }%
  \end{beamercolorbox}%
}

% ============================================================================
% BLOCK TEMPLATES
% ============================================================================
% Block titles render as bold navy text with a thin horizontal rule beneath,
% NOT a navy background bar. Body content begins directly under the rule.
% Same treatment applied to regular, alerted, and example blocks for uniform
% style across the poster.
% ============================================================================

\setbeamertemplate{block begin}{%
  \vskip0.5ex
  {\usebeamerfont{block title}\color{bracnavy}\bfseries\large\insertblocktitle\par}%
  \vskip-0.4ex
  {\color{bracnavy}\noindent\rule{\linewidth}{0.5pt}}%
  \vskip0.6ex
  \begin{beamercolorbox}[colsep*=0ex]{block body}%
    \usebeamerfont{block body}%
    \justifying
    \setlength{\parskip}{1ex}%
}
\setbeamertemplate{block end}{%
  \end{beamercolorbox}%
  \vskip0pt
  \vspace*{1.5ex}%
}

\setbeamertemplate{block alerted begin}{%
  \vskip0.5ex
  {\usebeamerfont{block title}\color{bracnavy}\bfseries\large\insertblocktitle\par}%
  \vskip-0.4ex
  {\color{bracnavy}\noindent\rule{\linewidth}{0.5pt}}%
  \vskip0.6ex
  \begin{beamercolorbox}[colsep*=0ex]{block alerted body}%
    \usebeamerfont{block body}%
    \justifying
    \setlength{\parskip}{1ex}%
}
\setbeamertemplate{block alerted end}{%
  \end{beamercolorbox}%
  \vskip0pt
  \vspace*{1.5ex}%
}

\setbeamertemplate{block example begin}{%
  \vskip0.5ex
  {\usebeamerfont{block title}\color{bracnavy}\bfseries\large\insertblocktitle\par}%
  \vskip-0.4ex
  {\color{bracnavy}\noindent\rule{\linewidth}{0.5pt}}%
  \vskip0.6ex
  \begin{beamercolorbox}[colsep*=0ex]{block example body}%
    \usebeamerfont{block body}%
    \justifying
    \setlength{\parskip}{1ex}%
}
\setbeamertemplate{block example end}{%
  \end{beamercolorbox}%
  \vskip0pt
  \vspace*{1.5ex}%
}
