# ── Claude Code local settings ───────────────────────────────────────────────
.claude/

# ── Editor backups ───────────────────────────────────────────────────────────
*.backup_*

# ── Local dev probes ─────────────────────────────────────────────────────────
.sync_probe

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── PyTorch / model weights ───────────────────────────────────────────────────
*.pt
*.pth
*.bin
*.safetensors
checkpoints/
runs/

# ── HuggingFace cache ──────────────────────────────────────────────────────────
.cache/
~/.cache/huggingface/

# ── FAISS index files ─────────────────────────────────────────────────────────
*.faiss
*.index

# ── Experiment outputs & logs ─────────────────────────────────────────────────
outputs/
results/
logs/
*.log
wandb/
mlruns/

# ── Data (raw benchmark datasets — download via HuggingFace datasets) ──────────
data/
datasets/

# ── Pickle / serialised state ─────────────────────────────────────────────────
*.pkl
*.pickle
*.meta

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Environment / secrets — NEVER commit these ───────────────────────────────
.env
.env.*
secrets.json
*.key
.caem-config

# ── pytest cache ──────────────────────────────────────────────────────────────
.pytest_cache/
pytest-cache-files-*/
htmlcov/
.coverage

# ── LaTeX build artefacts (thesis .tex files are tracked; build output is not) ─
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.out
*.lof
*.lot

# ── Keep these tracked ────────────────────────────────────────────────────────
# caem-unified-plan-v3.tex    ← tracked (thesis plan)
# caem-implementation-log.md  ← tracked (decision record)
# hyperparameter-reference.md ← tracked
# writing-suggestions.md      ← tracked
